{
  "description": "Agent Herder Codex autopilot: judge each Stop and either continue the same turn or notify the user.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/autopilot-hook-launcher.sh\"",
            "timeout": 45,
            "statusMessage": "Checking Agent Herder autopilot decision"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
