{
  "description": "Agent Herder Codex autopilot: judge each Stop and either continue the same turn or notify the user. Every command is safe: a hook that cannot start leaves the session alone.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-stop-hook.mjs\" 2>/dev/null || true",
            "timeout": 45,
            "statusMessage": "Checking Agent Herder autopilot decision"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\" 2>/dev/null || true",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\" 2>/dev/null || true",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\" 2>/dev/null || true",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/coordination-hook.mjs\" 2>/dev/null || true",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
