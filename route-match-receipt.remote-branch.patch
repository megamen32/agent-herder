+
+/** The route facts of one launch, as the receipt states them. */
+export interface ProjectLaunchRouteReceipt {
+  /** The route key that governed the launch. */
+  routeKey: string;
+  /** The requested working folder was replaced by the root of the route. */
+  workspaceReplaced: boolean;
 }
 
+/**
+ * The route facts of one launch.
+ *
+ * The route key names the route that governed the launch, found by the single
+ * lookup rule. The flag states that the root of the route replaced the
+ * requested working folder, which is the case for a directory inside the root
+ * of a route and for a folder the route is authoritative over.
+ */
+function routeReceiptOf(
+  routeKey: string | undefined,
+  project: string,
+  cwd?: string,
+): ProjectLaunchRouteReceipt | undefined {
+  if (!routeKey) return undefined;
+  const root = canonicalProjectKey(routeKey);
+  const requested = canonicalProjectKey(cwd || project);
+  return { routeKey, workspaceReplaced: root.startsWith("/") && requested !== root };
+}
+
 /** The durable key of a project: its configured route key, else the canonical name. */
 export function attemptKeyOf(policy: AutomationLaunchPolicy, project: string): string {
   return routeKeyOf(policy, project) ?? canonicalProjectKey(project);
