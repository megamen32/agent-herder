{
  "description": "Agent Herder Claude Code autopilot Stop hook.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/claude-autopilot-hook-launcher.sh\"",
            "timeout": 45,
            "statusMessage": "Checking Agent Herder autopilot decision"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_HERDER_HARNESS=claude node \"${CLAUDE_PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_HERDER_HARNESS=claude node \"${CLAUDE_PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_HERDER_HARNESS=claude node \"${CLAUDE_PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_HERDER_HARNESS=claude node \"${CLAUDE_PLUGIN_ROOT}/scripts/coordination-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Syncing Agent Herder coordination"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
