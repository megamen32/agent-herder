node_modules/
dist/
*.js.map
.env

# Local agent and analysis artifacts
.playwright-cli/
.superpowers/
graphify-out/

# Local runtime, IDE, worktree, and generated backup artifacts
.agent-herder/
.serena/
.tmpbin/
.tmp/
.worktrees/
.agents/last-human-commit/
.agents/shared-session/time/
dist.backup-*/
trash/
.agents/shared-session/compaction/
.agents/shared-session/knowledge/
.agents/tasks/*-time.json
**/__pycache__/

# Scoped local browser evidence for stable timing layout (2026-10-06)
.tmp/b/
.tmp/ui-timings-20261006/

# Finder view metadata; preserve locally without treating it as source work
.DS_Store

# Build, report, and snapshot artifacts that are not source work
dist.pre-*/
.vitest-reports/
.agents/shared-session/learning/
*.bak-*
*.bak.mavis-*
integrations/opencode/*.release-*.js

# Generated plan bookkeeping of the LHC tooling: mirror snapshots, locks and
# revision bundles are machine state of one publication, not source work.
.agents/tasks/*/.lhc-publication/
.agents/tasks/*/.lhc-leaves.lock
.agents/tasks/*/.lhc-graph-publication-*/
.agents/tasks/*/.lhc-bugs.lock

# Browser proof inputs kept next to their receipts: the screenshots and the
# SHA256 manifests are the tracked evidence, the raw profile state and the
# unpacked extension copies are inputs of that proof, not the proof itself.
.agents/tasks/*/evidence/**/profile-*/
.agents/tasks/*/evidence/**/extension-*/

# Generated index allowlist of the fleet indexer (ServersAdministartion).
.xerjignore
