#!/usr/bin/env python3
"""Update the central recovery owner using its prepared release."""

import argparse
import fcntl
import json
import os
import socket
import subprocess
import sys
from pathlib import Path

from deployment_config import private_json
from recovery_owner_update import atomic, check, digest


def read(path):
    return json.loads(Path(path).read_bytes())


def local_owner(entry, bundle, src, sha):
    receipt_path = Path(entry["receipt"])
    selector = Path(entry["selector"])
    candidate_selector = digest(bundle / "selector.json")
    if not receipt_path.exists():
        check(digest(selector) != candidate_selector,
              "local selector already switched; reconcile the existing release receipt")
        subprocess.run([entry["command"]], check=True, timeout=600)
    receipt = read(receipt_path)
    check(receipt["source"] == src and receipt["core_sha256"] == sha, "wrong local release receipt")
    check(digest(selector) == candidate_selector, "local core selector has changed")
    core = (bundle / "fixture/herder_native_stdio").resolve()
    expected = [
        os.fsencode(part)
        for profile in read(selector)["profiles"]
        for part in ("--trusted-owner-profile", profile)
    ]
    # A later boot can legitimately replace the PID in the original deployment receipt.
    candidates = (p.name for p in Path("/proc").iterdir() if p.name.isdigit())
    matched = []
    for pid in candidates:
        proc = Path("/proc") / pid
        try:
            if (
                os.readlink(proc / "exe") == str(core)
                and (proc / "cmdline").read_bytes().split(b"\0")[1:-1] == expected
            ):
                matched.append(proc)
        except (PermissionError, FileNotFoundError, ProcessLookupError):
            continue
    check(len(matched) == 1 and digest(matched[0] / "exe") == sha, "local routed core unavailable")
    return {"status": "verified", "sha256": sha, "core_pid": int(matched[0].name)}


def execute(plan, only):
    bundle = Path(plan["bundle"])
    manifest = read(bundle / "manifest.json")
    src = manifest["source_commit"]
    binary = bundle / "fixture/herder_native_stdio"
    sha = manifest["sha256"]["core"]
    check(src == plan["source"] and sha == digest(binary), "prepared native release identity changed")
    check(socket.gethostname() == plan["controller_host"], "run on the release authority")
    hosts = plan["hosts"]
    owners = [name for name, entry in hosts.items() if entry["mode"] == "local"]
    check(len(owners) == 1, "expected exactly one local central owner")
    name = owners[0]
    check(only is None or list(dict.fromkeys(only)) == owners,
          "recovery rollout can update only the central owner")
    root = Path(plan["journal"]) / src
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (root / "operator.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            result = local_owner(hosts[name], bundle, src, sha)
        except (RuntimeError, ValueError, OSError, KeyError, subprocess.SubprocessError) as error:
            result = {"status": "incomplete", "error": str(error)}
        print(json.dumps(dict(host=name, **result), ensure_ascii=False), flush=True)
        atomic(root / (name + ".json"), json.dumps(result).encode())
    return int(result["status"] != "verified")


if __name__ == "__main__":
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--plan", type=Path, default=Path.home() / ".config/agent-herder/recovery-rollout.json"
    )
    parser.add_argument("--host", action="append", dest="hosts")
    args = parser.parse_args()
    sys.exit(execute(private_json(args.plan.absolute()), args.hosts))
