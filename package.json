{
  "name": "agent-herder",
  "version": "0.2.0",
  "description": "Coordinate and supervise parent/child sessions across Claude, Codex, OpenCode, ZCode, Fast Agent, Hermes, and Qoder with MCP messaging, TTL coordination notes, session inspection, and autopilot.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-herder": "dist/index.js",
    "agent-herder-autopilot-hook": "dist/autopilot-hook.js",
    "agent-herder-claude-autopilot-hook": "dist/claude-autopilot-hook.js",
    "agent-herder-autopilot": "dist/autopilot-runner.js",
    "agent-herder-browserclaw-worker": "dist/browserclaw-worker-main.js",
    "agent-herder-cdp-chat-browserclaw": "dist/cdp-chat-browserclaw-main.js"
  },
  "scripts": {
    "build": "tsc && vite build --config vite.config.ts && cp -R dist/web-static/. dist/web/",
    "test": "npm run build && vitest run --root . --config vitest.config.ts",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    ".codex-plugin/plugin.json",
    ".codex-plugin/hooks.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "com.openai/hooks/hooks.json",
    "scripts/autopilot-hook-launcher.sh",
    "scripts/autopilot-command-launcher.sh",
    "scripts/install-zcode-autopilot.sh",
    "hooks/hooks.json",
    "scripts/claude-autopilot-hook-launcher.sh",
    "skills/autopilot/SKILL.md",
    "skills/autopilot/scripts/run.sh",
    "integrations/opencode/agent-herder-autopilot.js",
    "integrations/hermes/agent-herder-autopilot/__init__.py",
    "integrations/hermes/agent-herder-autopilot/plugin.yaml",
    "integrations/zcode/agent-herder-autopilot/.zcode-plugin/plugin.json",
    "integrations/zcode/agent-herder-autopilot/hooks/hooks.json",
    "integrations/zcode/agent-herder-autopilot/hooks/stop.mjs",
    "integrations/zcode/agent-herder-autopilot/hooks/user-prompt.mjs",
    "integrations/zcode/agent-herder-autopilot/commands/autopilot.md",
    "integrations/zcode/agent-herder-autopilot/README.md",
    "docs/assets/agent-herder-animated.svg",
    "docs/autopilot.md",
    "docs/codex-hooks.json",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "LICENSE",
    "package.json",
    "scripts/coordination-hook.mjs",
    "integrations/fast-agent/coordination_hooks.py",
    "integrations/zcode/agent-herder-autopilot/hooks/coordination.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "coding-agents",
    "agent-orchestration",
    "session-manager",
    "transcript-export",
    "parent-child-sessions",
    "opencode",
    "claude-code",
    "codex-cli",
    "qoder",
    "zcode",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "session-convert": "git+https://github.com/megamen32/session-convert.git#4a27a2b8f38500ef2ccab3dd41604e719efb2d2c",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
