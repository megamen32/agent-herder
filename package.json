{
  "name": "agent-herder",
  "version": "0.1.0",
  "description": "MCP server to monitor, inspect, search, and coordinate OpenCode, Claude Code, Codex CLI, Qoder, and ZCode parent/child sessions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-herder": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && vite build --config vite.config.ts && cp -R dist/web-static/. dist/web/",
    "test": "npm run build && vitest run --root .",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "docs/assets/agent-herder-animated.svg",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "coding-agents",
    "agent-orchestration",
    "session-manager",
    "transcript-export",
    "parent-child-sessions",
    "opencode",
    "claude-code",
    "codex-cli",
    "qoder",
    "zcode",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@mui/material": "^9.3.1",
    "@mui/x-chat": "^9.0.0-alpha.16",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "session-convert": "git+https://github.com/megamen32/session-convert.git#4a27a2b8f38500ef2ccab3dd41604e719efb2d2c",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
